	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"packages": {},
				"requests": {},
				"exec": [
					"pm.environment.set(\"EXPECTED_STATUS\", \"404\");",
					"pm.environment.set(\"EXPECTED_STATUS\", \"400\");",
					"pm.environment.unset(\"EXPECTED_STATUS\");",
					""
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"packages": {},
				"requests": {},
				"exec": [
					"// global safety TESTS",
					"",
					"// response ",
					"pm.test(\"Response is JSON when Content-Type is application/json\", function () {",
					"    const contentType = pm.response.headers.get(\"Content-Type\");",
					"    if (contentType && contentType.includes(\"application/json\")) {",
					"        pm.response.json();",
					"    }",
					"});",
					"",
					"// status code contract",
					"pm.test(\"Status code matches REST contract\", function () {",
					"    const expectedStatus = pm.environment.get(\"EXPECTED_STATUS\");",
					"    const actualStatus = pm.response.code;",
					"",
					"    if (expectedStatus) {",
					"        pm.expect(",
					"            actualStatus,",
					"            `Expected status ${expectedStatus} but got ${actualStatus}`",
					"        ).to.eql(Number(expectedStatus));",
					"        return;",
					"    }",
					"",
					"    // Default REST expectations",
					"    if (actualStatus >= 500) {",
					"        let msg = \"Unexpected server error\";",
					"        try {",
					"            const body = pm.response.json();",
					"            msg = body.message || body.error || body.msg || JSON.stringify(body);",
					"        } catch (e) {",
					"            msg = pm.response.text();",
					"        }",
					"",
					"        pm.expect.fail(`${actualStatus} ${pm.response.status}: ${msg}`);",
					"    }",
					"});",
					"",
					"",
					"// error response ",
					"if (pm.response.code >= 400) {",
					"    pm.test(\"Error response has a message field\", function () {",
					"        const body = pm.response.json();",
					"        pm.expect(body).to.be.an(\"object\");",
					"        pm.expect(",
					"            body,",
					"            \"Error response should include a message\"",
					"        ).to.satisfy(b =>",
					"            b.message || b.error || b.msg",
					"        );",
					"    });",
					"}",
					"",
					"",
					"// success response ",
					"if (pm.response.code >= 200 && pm.response.code < 300) {",
					"",
					"    pm.test(\"Status code is 200\", function () {",
					"        pm.expect(pm.response.code).to.eql(200);",
					"    });",
					"",
					"    pm.test(\"Response is valid JSON\", function () {",
					"        pm.response.json();",
					"    });",
					"",
					"    const data = pm.response.json();",
					"    const items = Array.isArray(data) ? data : [data];",
					"",
					" pm.test(\"Response is an object or array\", function () {",
					"        // Check if data is an Array OR a valid non-null Object",
					"        pm.expect(data).to.satisfy(d => ",
					"            Array.isArray(d) || (typeof d === 'object' && d !== null)",
					"        );",
					"    });",
					"    function isFullGoal(item) {",
					"        const goalProps = [",
					"            \"user\",",
					"            \"text\",",
					"            \"status\",",
					"            \"_id\",",
					"            \"createdAt\",",
					"            \"updatedAt\"",
					"        ];",
					"        return goalProps.some(p => item.hasOwnProperty(p));",
					"    }",
					"",
					"    if (items.length && isFullGoal(items[0])) {",
					"        pm.test(\"Each goal has required properties\", function () {",
					"            const required = [",
					"                \"user\",",
					"                \"text\",",
					"                \"status\",",
					"                \"_id\",",
					"                \"createdAt\",",
					"                \"updatedAt\"",
					"            ];",
					"",
					"            items.forEach((item, i) => {",
					"                required.forEach(prop => {",
					"                    pm.expect(",
					"                        item,",
					"                        `Item ${i} missing '${prop}'`",
					"                    ).to.have.property(prop);",
					"                });",
					"            });",
					"        });",
					"",
					"        pm.test(\"Each 'user' is a valid MongoDB ObjectId\", function () {",
					"            items.forEach((item, i) => {",
					"                pm.expect(",
					"                    item.user,",
					"                    `Item ${i} has invalid user ObjectId`",
					"                ).to.match(/^[a-fA-F0-9]{24}$/);",
					"            });",
					"        });",
					"    }",
					"}",
					""
				]
			}
		}
